package LabTuan2;
import java.util.Scanner;
class SinhVien {
    int maSV;
    String hoTen;
    float diemLT;
    float diemTH;
    SinhVien() {
        maSV = 0;
        hoTen = "";
        diemLT = 0;
        diemTH = 0;
    }
    SinhVien(int mssv, String ten, float lt, float th) {
        maSV = mssv;
        hoTen = ten;
        diemLT = lt;
        diemTH = th;
    }
    float diemTB() {
        return (diemLT + diemTH) / 2;
    }
    void inThongTin() {
        System.out.println(maSV + "  " + hoTen + "  " + diemLT + "  " + diemTH + "  " + diemTB());
    }
}
 class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        SinhVien sv1 = new SinhVien(123, "Mai Viet Hoang", 10, 10);
        SinhVien sv2 = new SinhVien(321, "Hoang Viet Mai", 10, 10);
        SinhVien sv3 = new SinhVien();
        System.out.print("Nhap mssv sv3: ");
        sv3.maSV = sc.nextInt();
        sc.nextLine();
        System.out.print("Nhap ho ten sv3: ");
        sv3.hoTen = sc.nextLine();
        System.out.print("Nhap diem ly thuyet sv3: ");
        sv3.diemLT = sc.nextFloat();
        System.out.print("Nhap diem thuc hanh sv3: ");
        sv3.diemTH = sc.nextFloat();
        System.out.println("masv hoten         diemLT diemTH diemTB");
        sv1.inThongTin();
        sv2.inThongTin();
        sv3.inThongTin();
    }
}
