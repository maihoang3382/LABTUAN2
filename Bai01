package LabTuan2;
import java.util.Arrays;
import java.util.Scanner;
class mangphantu {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("nhap so phan tu mang: ");
        int a = scanner.nextInt();
        int[] arr = new int[a];
        System.out.println("nhap cac phan tu:");
        for (int i = 0; i < a; i++) {
            System.out.print("arr[" + i + "] = ");
            arr[i] = scanner.nextInt();
        }
        System.out.println("mang cua ban:");
        for (int giatri : arr) {
            System.out.print(giatri + " ");
        }
        System.out.println();
        System.out.print("nhap gia tri can tim: ");
        int b = scanner.nextInt();
        boolean found = false;
        for (int i = 0; i < a; i++) {
            if (arr[i] == b) {
                System.out.println("Phan tu " + b + " xuat hien tai: " + i);
                found = true;
                break;
            }
        }
        if (!found) {
            System.out.println("Khong co phan tu " + b + " trong mang");
        }
        int max = arr[0];
        for (int giatri : arr) {
            if (giatri > max) {
                max = giatri;
            }
        }
        System.out.println("gia tri lon nhat trong mang: " + max);
        int min = arr[0];
        for (int giatri : arr) {
            if (giatri < min) {
                min = giatri;
            }
        }
        System.out.println("gia tri nho nhat ttrong mang: " + min);
        int maxIndex = 0;
        for (int i = 1; i < a; i++) {
            if (arr[i] > arr[maxIndex]) {
                maxIndex = i;
            }
        }
        System.out.println("vi tri co phan tu lon nhat: " + maxIndex);
        Arrays.sort(arr);
        System.out.println("mang tang dan:");
        for (int giatri : arr) {
            System.out.print(giatri + " ");
        }}}
